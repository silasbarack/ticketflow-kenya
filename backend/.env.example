# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ticketflow_kenya?schema=public"

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# M-Pesa Daraja (Safaricom) sandbox credentials
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_daraja_passkey
# NOTE the /api prefix — the whole API is mounted under it (main.ts). Pointing
# Safaricom at /payments/mpesa/callback returns 404 and every payment then hangs
# until the reconciliation sweep expires it.
MPESA_CALLBACK_URL=https://your-public-domain.com/api/payments/mpesa/callback
MPESA_ENV=sandbox

# --- STK push reliability (all optional; defaults shown) -------------------
# Per-request timeout for every Daraja call. Without one, a socket that never
# answers hangs the customer's checkout indefinitely.
MPESA_HTTP_TIMEOUT_MS=20000
# Extra attempts for a transient Daraja failure (network drop, 429, gateway 5xx).
MPESA_HTTP_RETRIES=2
# How long one STK prompt stays valid. Safaricom drops an unanswered prompt at
# about 60s; the headroom covers the callback coming back late.
MPESA_STK_TIMEOUT_SECONDS=90
# Grace period before the first stkpushquery, and the floor between queries.
MPESA_STK_QUERY_AFTER_SECONDS=8
MPESA_STK_QUERY_INTERVAL_MS=4000
# Absolute cut-off. Past this a payment is expired even when Daraja never gave a
# usable answer, so an order can never hold its stock forever. A success landing
# afterwards is still honoured.
MPESA_STK_HARD_EXPIRY_SECONDS=900
# Background sweep that settles payments whose callback never arrived. Leave on
# in every environment that takes payments.
MPESA_RECONCILIATION_ENABLED=true

# Frontend origin (for CORS)
FRONTEND_URL=http://localhost:3000

# Server
PORT=4000

# Platform commission (percentage, default 9 = 9%)
PLATFORM_COMMISSION_PERCENT=9

# Enable development-only mock payment endpoint (never enable in production)
ENABLE_MOCK_PAYMENTS=true

# --- Password reset (6-digit emailed code) --------------------------------
# Keys the HMAC that stores reset codes. A dedicated secret means rotating
# JWT_SECRET does not silently invalidate codes, and vice versa. Falls back to
# JWT_SECRET when unset. Generate with: openssl rand -hex 32
PASSWORD_RESET_SECRET=replace_with_a_long_random_secret
# LOCAL DEVELOPMENT ONLY: when SMTP is not configured, print the reset code to
# the server console so the flow can be completed. Ignored when
# NODE_ENV=production. Never enable anywhere real users exist.
PASSWORD_RESET_DEV_LOG_CODES=false

# Number of reverse proxies in front of the API (Render: 1). Required for
# per-IP rate limiting to see real client addresses. Leave unset locally —
# trusting a proxy that is not there lets clients spoof their IP.
# TRUST_PROXY=1

# Ticket QR code signing secret (generate with: openssl rand -hex 32)
TICKET_QR_SECRET=replace_with_a_long_random_secret

# Public URL of this API (used in ticket PDF links)
APP_URL=https://your-api-domain.onrender.com

# Email delivery. Use Resend in production: it sends over HTTPS, so it works on
# hosts that block outbound SMTP (Render's free tier). When RESEND_API_KEY is set
# it is used and the SMTP_* settings are ignored. Leave both blank to disable
# email — tickets still generate and can be downloaded from My Tickets.
RESEND_API_KEY=
# Sender shown to buyers. With Resend it must be on a domain verified in your
# Resend account; until you verify one, use "TicketFlow Kenya <onboarding@resend.dev>",
# which Resend only delivers to your own Resend account's email address.
EMAIL_FROM="TicketFlow Kenya <tickets@ticketflow.co.ke>"

# SMTP email delivery (local development / hosts that allow SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="TicketFlow Kenya <tickets@ticketflow.co.ke>"

# ===========================================================================
# Kenyan tax-compliance module (src/tax/) — see docs/ticketflow-tax-architecture.md
# ===========================================================================

# Master switch. When false, tax API routes still exist but all background
# jobs (eTIMS retry, deadline alerts, etc.) no-op — see TaxJobsService.
TAX_MODULE_ENABLED=true
TAX_DEFAULT_CURRENCY=KES

# Default business model. PRINCIPAL_RESELLER is supported by the domain
# logic but must never be the default — see docs/ticketflow-tax-architecture.md.
TICKETFLOW_AGENCY_MODEL=DISCLOSED_AGENT

# TicketFlow's own VAT registration status — affects whether TicketFlow
# charges VAT on its own booking-fee/commission revenue. Set via the
# CompanyTaxProfile record in practice (PATCH /admin/tax/company-profile);
# this var is a deploy-time seed default only, not read at request time.
TICKETFLOW_VAT_STATUS=REGISTERED

# AES-256-GCM key (64 hex chars = 32 bytes) used to encrypt KRA PINs and
# PRNs at rest. Generate with: openssl rand -hex 32
# Rotate per docs/ticketflow-tax-architecture.md "Key rotation" — do NOT
# just overwrite this in place without a re-encryption migration, or every
# already-encrypted PIN/PRN becomes unreadable.
TAX_ENCRYPTION_KEY=

# eTIMS (electronic Tax Invoice Management System) — OSCU/VSCU
# system-to-system integration. DISABLED and SANDBOX never fabricate a
# real KRA submission. OSCU/VSCU require KRA-issued credentials and
# certificates obtained through onboarding/certification — see
# docs/ticketflow-etims-integration.md. Until those are installed,
# EtimsProductionAdapter fails closed regardless of what is set here.
ETIMS_MODE=SANDBOX
ETIMS_BASE_URL=
ETIMS_CLIENT_ID=
ETIMS_CLIENT_SECRET=
ETIMS_CERTIFICATE_PATH=
ETIMS_PRIVATE_KEY_PATH=

# KRA tax payment. eTIMS invoicing and KRA tax payment are separate KRA
# processes — see docs/ticketflow-tax-payment-runbook.md. MANUAL_PRN is the
# only mode implemented end-to-end today: finance pastes a PRN generated
# through iTax and records the resulting bank/M-Pesa payment reference.
# APPROVED_BANK_INTEGRATION / APPROVED_MPESA_INTEGRATION are typed,
# fail-closed interfaces only — do not enable until a real, authorised
# treasury integration exists.
KRA_TAX_PAYMENT_MODE=MANUAL_PRN
KRA_PAYMENT_CHANNEL=
KRA_PAYBILL_NUMBER=
KRA_TAX_BANK_ACCOUNT_TOKEN=

# Maker-checker (two-person) control on tax approvals/payments.
TAX_MAKER_CHECKER_ENABLED=true
# Liabilities at or below this amount (minor units, e.g. "10000" = KES 100.00)
# may use a documented low-value single-approver exception. Leave blank to
# require maker-checker on every liability regardless of amount.
TAX_PAYMENT_APPROVAL_THRESHOLD_MINOR=

# --- M-Pesa callback authenticity ------------------------------------------
# Daraja does not sign callbacks. Set a long random token and append it to the
# callback URL: MPESA_CALLBACK_URL=https://…/api/payments/mpesa/callback?token=<token>
# Callbacks without it are ignored. If unset, every callback is confirmed with
# the stkpushquery API before it can settle a payment.
MPESA_CALLBACK_TOKEN=
# Optional comma-separated source-IP allowlist (requires TRUST_PROXY behind Render).
MPESA_CALLBACK_ALLOWED_IPS=
# Also confirm authenticated callbacks with the status query (belt and braces).
MPESA_CALLBACK_REQUIRE_QUERY_CONFIRMATION=false

# --- AI (docs/AI_AUTOMATION.md) -------------------------------------------
# Master switch. Each feature must ALSO be enabled by an admin (Admin → AI Settings).
AI_ENABLED=false
# Features switched on by default: "all" or a comma-separated list, e.g.
# SUPPORT_CHAT,EVENT_ASSISTANT. A setting saved in Admin -> AI Settings wins.
AI_FEATURES_ENABLED=
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
# Only used for models missing from src/ai/ai-pricing.ts (USD per million tokens).
AI_COST_INPUT_PER_MTOK=
AI_COST_OUTPUT_PER_MTOK=

# --- Automation engine ------------------------------------------------------
AUTOMATION_WORKER_ENABLED=true
AUTOMATION_MONITORS_ENABLED=true
EVENT_REMINDERS_ENABLED=true
ADMIN_ALERT_EMAILS=
SUPPORT_RETENTION_DAYS=180
# Risk-rule thresholds (defaults shown in src/automation/risk-monitor.service.ts)
# RISK_DUPLICATE_SCANS=2
# RISK_BAD_SIGNATURE_SCANS=3
# RISK_PAYMENT_FAILURES_PER_HOUR=5
# RISK_ORDERS_PER_10_MIN=8
# RISK_UNPAID_ORDERS_PER_DAY=10
# RISK_TICKETS_PER_BUYER_PER_EVENT=20
# RISK_EVENTS_PER_ORGANIZER_PER_DAY=10
# RISK_REFUND_REQUESTS_PER_30_DAYS=3

# One-off: promote this EXISTING account to an active admin at startup (same as
# `npm run create-admin -- --email <email>`). Never creates accounts or changes
# passwords; audit-logged. Clear it again once the account is an admin.
BOOTSTRAP_ADMIN_EMAIL=
