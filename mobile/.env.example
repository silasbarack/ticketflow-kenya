# Copy to `.env` and set for your environment. `.env` is gitignored — never commit it.
#
# Base URL of the TicketFlow Kenya backend API, including the /api prefix.
EXPO_PUBLIC_API_URL=https://your-ticketflow-backend.example.com/api

# ---------------------------------------------------------------------------
# Choosing a value
# ---------------------------------------------------------------------------
# Deployed backend (works everywhere, required for preview/production builds):
#   EXPO_PUBLIC_API_URL=https://your-ticketflow-backend.example.com/api
#
# Local backend during development — use your computer's LAN IP, never
# `localhost`. On a physical phone, `localhost` means the phone itself, so the
# request never reaches your machine. Find the IP with `ipconfig` (Windows) and
# keep the phone on the same Wi-Fi network:
#   EXPO_PUBLIC_API_URL=http://192.168.x.x:4000/api
#
# Plain HTTP only works in the development build (its debug variant permits
# cleartext traffic). Preview and production builds are release variants and
# require an HTTPS URL.
#
# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Everything prefixed EXPO_PUBLIC_ is compiled into the app bundle and is
# readable by anyone who installs it. Never put M-Pesa consumer keys or
# secrets, the Daraja passkey, JWT signing secrets, database credentials or
# any private API key here — those belong in backend/.env only.

# ---------------------------------------------------------------------------
# Web app origin (poster artwork)
# ---------------------------------------------------------------------------
# Event posters are static assets of the Next.js web app, not something the API
# serves, so they are fetched from here rather than from EXPO_PUBLIC_API_URL.
# Leave unset in development and the app uses Metro's host on port 3000, which
# is correct whenever you run the web app on the same machine.
#
#   EXPO_PUBLIC_WEB_URL=https://your-ticketflow-frontend.example.com
#   EXPO_PUBLIC_WEB_URL=http://192.168.x.x:3000
EXPO_PUBLIC_WEB_URL=
